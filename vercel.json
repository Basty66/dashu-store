{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin"
    },
    {
      "source": "/api/checkout/:path*",
      "destination": "/api/checkout/[...slug]"
    },
    {
      "source": "/api/webhooks/:path*",
      "destination": "/api/webhooks/[...slug]"
    },
    {
      "source": "/api/seminars/:path*",
      "destination": "/api/seminars"
    },
    {
      "source": "/api/products/:path*",
      "destination": "/api/public"
    },
    {
      "source": "/api/images/:path*",
      "destination": "/api/public"
    },
    {
      "source": "/api/contact",
      "destination": "/api/public"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/public"
    },
    {
      "source": "/api/distributors",
      "destination": "/api/public"
    },
    {
      "source": "/api/health",
      "destination": "/api/public"
    },
    {
      "source": "/api/settings",
      "destination": "/api/public"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; frame-src https://www.instagram.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.mercadopago.cl https://*.mercadopago.com"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
