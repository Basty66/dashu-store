@echo off
powershell -command "& { $p = Get-NetTCPConnection -LocalPort 3001 -ErrorAction SilentlyContinue | Where-Object State -eq Listen | Select-Object -First 1; if ($p) { Write-Host 'Stopping API server...'; Stop-Process -Id $p.OwningProcess -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2 }; Set-Location -LiteralPath '%~dp0'; Write-Host 'Starting API dev-server...'; Start-Process -FilePath 'node.exe' -WorkingDirectory '%~dp0' -ArgumentList 'dev-server.js' -WindowStyle Hidden; Start-Sleep -Seconds 3; $c = Get-NetTCPConnection -LocalPort 3001 -ErrorAction SilentlyContinue | Where-Object State -eq Listen; if ($c) { Write-Host 'API server running on port 3001' } else { Write-Host 'FAILED to start API server' } }"
