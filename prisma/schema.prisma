generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// Todos los montos se guardan en pesos chilenos enteros (CLP), sin decimales.

model Product {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  title       String
  brand       String      @default("DASHU")
  subtitle    String      @default("")
  description String
  howToUse    String      @default("")
  ingredients String      @default("")
  contentSize String      @default("")
  category    String      @default("alisado")
  images      String[]
  stock       Int         @default(0) // unidades sueltas disponibles
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  packs       Pack[]
  orderItems  OrderItem[]
}

// Formato de venta: unidad suelta (units = 1) o pack de N unidades.
model Pack {
  id           Int       @id @default(autoincrement())
  productId    Int
  units        Int
  price        Int // precio total del pack (precio normal)
  isActive     Boolean   @default(true)
  // Oferta: precio rebajado con fechas opcionales (sin fechas = vigente hasta quitarla).
  salePrice    Int?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, units])
}

model Order {
  id               Int          @id @default(autoincrement())
  orderNumber      String       @unique
  accessToken      String       @unique
  status           String       @default("PENDIENTE_PAGO")
  subtotal         Int
  shippingCost     Int          @default(0)
  discount         Int          @default(0)
  total            Int
  couponCode       String?
  paymentMethod    String       @default("mercadopago")
  paymentStatus    String?
  mpPreferenceId   String?
  mpPaymentId      String?
  paidAt           DateTime?
  expiresAt        DateTime?
  stockReleased    Boolean      @default(false)
  customerName     String
  customerEmail    String
  customerPhone    String
  customerRut      String?
  documentType     String       @default("boleta")
  businessName     String?
  businessActivity String?
  shippingRegion   String
  shippingCommune  String
  shippingAddress  String
  notes            String?
  courier          String?
  trackingNumber   String?
  trackingUrl      String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  items            OrderItem[]
  events           OrderEvent[]

  @@index([status, expiresAt])
  @@index([customerEmail])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?
  title     String
  packUnits Int // unidades por pack (1 = suelta)
  quantity  Int // cantidad de packs
  unitPrice Int // precio de un pack
  lineTotal Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// Historial visible para el cliente: "Recibimos tu pedido", "En camino con Starken", etc.
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String    @default("percentage") // percentage | fixed
  value     Int // % o monto CLP
  minTotal  Int       @default(0) // subtotal mínimo CLP
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Review {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerEmail String?
  rating        Int
  comment       String
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Imágenes subidas desde el admin (ya comprimidas en el navegador). Se sirven en /api/images/:id
model ProductImage {
  id        Int      @id @default(autoincrement())
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

// ---------- Capacitaciones ----------

// Seminario, curso o clase práctica con cupos limitados.
model Seminar {
  id               Int          @id @default(autoincrement())
  slug             String       @unique
  title            String
  kind             String       @default("seminario") // seminario | curso | clase | evento
  summary          String       @default("")
  description      String       @default("")
  city             String
  venue            String       @default("")
  address          String       @default("")
  host             String       @default("") // anfitrión o invitados (ej: "Bemol Barbería con Angelito")
  date             DateTime // día del evento, guardado a mediodía hora de Chile
  startTime        String? // "10:00"; sin hora = evento de día completo en el calendario
  endTime          String?
  scheduleNote     String       @default("") // ej: "Bloque AM"
  price            Int? // null = valor por confirmar: se reciben pre-inscripciones sin pago
  capacity         Int          @default(20)
  seatsTaken       Int          @default(0) // cupos pagados o reservados mientras pagan
  isPublished      Boolean      @default(true)
  isCancelled      Boolean      @default(false)
  image            String?
  calendarEventId  String?
  calendarSyncedAt DateTime?
  calendarError    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  enrollments      Enrollment[]

  @@index([date])
}

model Enrollment {
  id             Int       @id @default(autoincrement())
  code           String    @unique // SEM-XXXXXX
  accessToken    String    @unique
  seminarId      Int
  status         String    @default("PENDIENTE_PAGO") // PREINSCRITO | PENDIENTE_PAGO | PAGADO | CANCELADO | EXPIRADO
  holdsSeat      Boolean   @default(false)
  name           String
  email          String
  phone          String
  rut            String?
  business       String?
  notes          String?
  amount         Int       @default(0)
  paymentMethod  String? // mercadopago | manual
  paymentStatus  String?
  mpPreferenceId String?
  mpPaymentId    String?
  paidAt         DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  seminar        Seminar   @relation(fields: [seminarId], references: [id], onDelete: Restrict)

  @@index([seminarId, status])
  @@index([status, expiresAt])
}

// Postulaciones al programa de distribuidores.
model DistributorLead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  business  String
  rut       String?
  region    String
  city      String
  boxes     Int      @default(3)
  message   String?
  status    String   @default("NUEVO") // NUEVO | CONTACTADO | APROBADO | DESCARTADO
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuración clave/valor (ej: conexión con Google Calendar).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
