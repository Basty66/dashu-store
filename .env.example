# ── Base de datos (Neon Postgres) ─────────────────────────────
# DATABASE_URL: conexión "pooled" (host con -pooler) para las funciones.
# DIRECT_DATABASE_URL: conexión directa, solo para `prisma db push`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Panel de administración (/admin) ─────────────────────────
# Primer ingreso: con ADMIN_EMAIL (más abajo) + ADMIN_PASSWORD se crea la cuenta de dueño y el
# panel pide crear una clave propia. Desde ahí cada persona entra con su correo y su clave
# (Admin → Equipo) y estas dos variables ya no sirven para entrar.
ADMIN_PASSWORD="cambia-esta-contraseña"
# Recomendado: secreto largo y aleatorio para firmar las sesiones (si no, usa ADMIN_PASSWORD).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_SECRET=""

# ── Mercado Pago (Checkout Pro) ──────────────────────────────
# Token de producción desde https://www.mercadopago.cl/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=""
# Opcional: clave secreta de webhooks para validar la firma x-signature
# MP_WEBHOOK_SECRET=""
# Solo desarrollo local: simula el pago sin Mercado Pago (nunca se activa en Vercel)
# PAYMENTS_MOCK="1"

# ── URL pública (links de pago, webhooks y correos) ──────────
# En Vercel se detecta sola; úsala si tienes dominio propio.
# PUBLIC_SITE_URL="https://www.tudominio.cl"

# ── Google Calendar (capacitaciones) — opcional ─────────────
# Crea un cliente OAuth (tipo Aplicación web) en Google Cloud con la Calendar API habilitada.
# URI de redirección autorizada: https://TU-DOMINIO/api/admin/google/callback
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET=""

# ── Correos (Resend) — opcional ──────────────────────────────
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="DASHU STORE <pedidos@tudominio.cl>"
# Recibe los avisos de pedidos y postulaciones, y es el correo del primer ingreso al panel.
ADMIN_EMAIL="tu-correo@ejemplo.cl"

# ── Frontend (VITE_ se expone al navegador) ──────────────────
VITE_WHATSAPP_NUMBER="569XXXXXXXX"
